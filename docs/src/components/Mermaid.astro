---
interface Props {
  code: string;
}
const { code } = Astro.props;
---

<div class="mermaid-diagram not-content" data-mermaid={code}>
  <pre>{code}</pre>
</div>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'neutral',
    c4: { diagramMarginY: 20 },
  });

  async function renderDiagrams() {
    const diagrams = document.querySelectorAll<HTMLElement>('.mermaid-diagram[data-mermaid]');
    for (const el of diagrams) {
      const code = el.dataset.mermaid ?? '';
      if (!code || el.dataset.rendered) continue;
      el.dataset.rendered = 'true';
      const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;
      try {
        const { svg } = await mermaid.render(id, code);
        el.innerHTML = svg;
      } catch (err) {
        console.error('Mermaid render error:', err);
        el.innerHTML = `<pre style="color:red">Render hiba: ${err}</pre>`;
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderDiagrams);
  } else {
    renderDiagrams();
  }
</script>

<style>
  .mermaid-diagram {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    padding: 1.5rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }
</style>
