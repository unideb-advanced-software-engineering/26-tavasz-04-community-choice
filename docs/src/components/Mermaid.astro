---
interface Props {
	chart: string;
	title?: string;
}

const { chart, title = 'Diagram' } = Astro.props;
---

<figure class="cc-mermaid-figure" aria-label={title}>
	<pre class="mermaid">{chart}</pre>
	<figcaption>{title}</figcaption>
</figure>

<script>
	import mermaid from 'mermaid';

	mermaid.initialize({
		startOnLoad: false,
		securityLevel: 'strict',
		theme: 'base',
		state: {
			useMaxWidth: true,
			padding: 8,
			textHeight: 14,
		},
		themeVariables: {
			fontFamily: 'Inter, Arial, sans-serif',
			fontSize: '13px',
			background: 'transparent',
			mainBkg: '#dcfce7',
			secondBkg: '#dbeafe',
			tertiaryBkg: '#fef9c3',
			primaryColor: '#dcfce7',
			primaryTextColor: '#14532d',
			primaryBorderColor: '#15803d',
			secondaryColor: '#dbeafe',
			secondaryTextColor: '#1e40af',
			secondaryBorderColor: '#2563eb',
			tertiaryColor: '#fef9c3',
			tertiaryTextColor: '#854d0e',
			tertiaryBorderColor: '#ca8a04',
			lineColor: '#15803d',
			textColor: '#292524',
			noteBkgColor: '#f5f5f4',
			noteTextColor: '#292524',
			activationBkgColor: '#15803d',
			activationBorderColor: '#14532d',
			activationTextColor: '#ffffff',
		},
	});

	const renderMermaid = async () => {
		await mermaid.run({
			querySelector: '.cc-mermaid-figure .mermaid',
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', renderMermaid, { once: true });
	} else {
		renderMermaid();
	}
</script>

<style>
	.cc-mermaid-figure {
		margin: 1rem 0;
		padding: 0.25rem 0;
		overflow-x: auto;
		border: 0;
		background: transparent;
		box-shadow: none;
	}

	.cc-mermaid-figure .mermaid {
		min-width: 28rem;
		margin: 0;
		text-align: center;
		background: transparent;
	}

	.cc-mermaid-figure :global(svg) {
		max-width: 100%;
		height: auto;
	}

	.cc-mermaid-figure figcaption {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: 0.875rem;
		text-align: center;
	}

	:global([data-theme='dark']) .cc-mermaid-figure {
		background: transparent;
	}
</style>
