specification {
	element actor {
		style {
			shape person
			color green
		}
	}

	element system {
		style {
			color primary
		}
	}

	element externalSystem {
		style {
			color amber
		}
	}

	element webapp {
		style {
			shape browser
			color sky
			icon tech:react
		}
	}

	element service {
		style {
			shape component
			color indigo
			icon tech:nodejs
		}
	}

	element worker {
		style {
			shape component
			color green
			icon tech:nodejs
		}
	}

	element queue {
		style {
			shape queue
			color red
			icon tech:rabbitmq
		}
	}

	element database {
		style {
			shape cylinder
			color blue
			icon tech:postgresql
		}
	}

	element cache {
		style {
			shape cylinder
			color red
			icon tech:redis
		}
	}

	element storage {
		style {
			color amber
		}
	}

    element component {
        style {
            shape rectangle
            color slate
        }
    }
}

model {
	allampol = actor 'Zamundai állampolgár' 'Ötleteket javasol és szavaz a helyi pályázatokon' 'Reszponzív böngésző'
	admin = actor 'Közigazgatási adminisztrátor' 'Pályázatokat hirdet és moderál' 'Hivatali böngésző'

	zamundaOne = externalSystem 'Zamunda One' 'Állami azonosítási és lakcímadat-szolgáltató API' 'OAuth2 / OpenID Connect + REST API' {
		style {
			color amber
		}
	}

	cdn = externalSystem 'Cloudflare CDN' 'Tömörített médiatartalmak gyors kiszolgálása' 'Cloudflare CDN' {
		style {
			color amber
		}
	}

	cc = system 'Community Choice platform' 'Lehetővé teszi a polgárok számára helyi fejlesztési ötletek beküldését és szavazását' {
		
        webApp = webapp 'Webalkalmazás' 'Felhasználói felület pályázatokhoz, ötletekhez és szavazáshoz' 'React + TypeScript' {
			style {
				color sky
				icon tech:react
				shape browser
			}
		}

		votingService = service 'Szavazási szolgáltatás' 'Szavazatok rögzítése és integritásának biztosítása' 'Node.js + NestJS' {
			style { color green; icon tech:nestjs }

            votingController = component 'Szavazási vezérlő' 'Kezeli a szavazatok beérkezését' 'NestJS vezérlő'
            votingLogic = component 'Szavazási logika' 'Üzleti logika: egy felhasználó egy ötletre csak egyszer szavazhat' 'NestJS szolgáltatás'
            voteZamundaClient = component 'Zamunda One kliens' 'Hitelesítés és lakcím-ellenőrzés, hogy csak helyi lakos szavazhasson' 'HTTP kliens'
            voteRepo = component 'Szavazati adattár' 'A csak hozzáfűzhető szavazatok mentése tranzakcionálisan' 'TypeORM'
            rateLimiter = component 'Forgalomkorlátozó' 'API-hívások korlátozása DDoS-védelemhez' 'NestJS elfogó'

            votingController -> rateLimiter 'Ellenőrzi a limitet'
            votingController -> votingLogic 'Szavazat feldolgozása'
            votingLogic -> voteZamundaClient 'Lakcím és jogosultság ellenőrzése'
            votingLogic -> voteRepo 'Adatbázisba mentés'
		}

		campaignAdminService = service 'Pályázat- és adminisztrációkezelő szolgáltatás' 'Pályázatok, ötletek, médiafeltöltések és adminisztrációs műveletek kezelése' 'Node.js + NestJS' {
			style { color indigo; icon tech:nestjs }

            publicApi = component 'Nyilvános lista API' 'Optimalizált, alacsony sávszélességű lekérdezések' 'NestJS vezérlő'
            ideaApi = component 'Ötletbeküldő API' 'Ötletek és probléma-megoldás párok beküldése' 'NestJS vezérlő'
            adminApi = component 'Adminisztrációs API' 'Pályázatok meghirdetése és moderációja' 'NestJS vezérlő'
            uploadManager = component 'TUS feltöltéskezelő' 'Fájldarabok összefűzése és megszakítható feltöltések kezelése' 'TUS protokollkezelő'
            eventPublisher = component 'Médiaesemény-küldő' 'Aszinkron feldolgozási események küldése' 'RabbitMQ kliens'
            campaignRepo = component 'Pályázati adattár' 'Adatbázisműveletek' 'TypeORM'
            
            publicApi -> campaignRepo 'Lekérdezések (paginált JSON)'
            ideaApi -> uploadManager 'Fájldarabok átadása'
            ideaApi -> campaignRepo 'Ötlet metaadatok mentése'
            adminApi -> campaignRepo 'Adminisztrációs adatok mentése'
            uploadManager -> eventPublisher 'Feltöltés kész esemény generálása'
		}

		messageBroker = queue 'Üzenetközvetítő' 'Aszinkron eseménysor a médiafeldolgozáshoz' 'RabbitMQ' {
			style { color red; icon tech:rabbitmq }
		}

		mediaWorker = worker 'Médiafeldolgozó háttérfolyamat' 'Képek és videók átméretezése és tömörítése' 'Node.js háttérfolyamat' {
			style { color amber; icon tech:ffmpeg }

            consumer = component 'Eseményfeldolgozó' 'Üzenetek fogadása a sorból' 'AMQP kliens'
            imageProcessor = component 'Képtömörítő' 'Képek átméretezése klímabarát méretre' 'Sharp'
            videoProcessor = component 'Videótömörítő' 'Videók tömörítése alacsony sávszélességhez' 'FFmpeg'
            storageUploader = component 'Tárolófeltöltő' 'A feldolgozott fájlok feltöltése' 'MinIO kliens'

            consumer -> imageProcessor 'Kép feldolgozása'
            consumer -> videoProcessor 'Videó feldolgozása'
            imageProcessor -> storageUploader 'Kész kép átadása'
            videoProcessor -> storageUploader 'Kész videó átadása'
		}

		database = database 'Relációs adatbázis' 'Szavazatok, pályázatok, ötletek, felhasználók - közös adatbázis' 'PostgreSQL' {
			style { color blue; icon tech:postgresql }
		}

		cache = cache 'Gyorsítótár' 'Időzített munkamenet, forgalomkorlát és nyilvános lista gyors tárolása' 'Redis' {
			style { color red; icon tech:redis }
		}

		mediaStorage = storage 'Médiafájltároló' 'Eredeti és tömörített képek, videók' 'MinIO objektumtár' {
			style { color amber }
		}

        // Webalkalmazás a belső komponensek felé
		webApp -> votingService.votingController 'Szavazat leadása' 'HTTPS/JSON'
		webApp -> campaignAdminService.publicApi 'Pályázatok és ötletek böngészése' 'HTTPS/JSON'
        webApp -> campaignAdminService.ideaApi 'Ötletek és média feltöltése' 'HTTPS / TUS'
        webApp -> campaignAdminService.adminApi 'Adminisztrációs műveletek' 'HTTPS/JSON'
		webApp -> zamundaOne 'Hitelesítés' 'OAuth2 / OpenID Connect'

        // Szavazási szolgáltatás az infrastruktúra felé
        votingService.voteZamundaClient -> zamundaOne 'Lakcím lekérdezése' 'REST'
        votingService.voteRepo -> database 'Szavazatok mentése (csak hozzáfűzhető)' 'PostgreSQL protokoll'
        votingService.rateLimiter -> cache 'Forgalomkorlátozási kulcsok' 'Redis protokoll'

        // Pályázat- és adminisztrációkezelő szolgáltatás az infrastruktúra felé
        campaignAdminService.campaignRepo -> database 'Adatok mentése és olvasása' 'PostgreSQL protokoll'
        campaignAdminService.publicApi -> cache 'Lekérdezések gyorsítótárazása' 'Redis protokoll'
        campaignAdminService.eventPublisher -> messageBroker 'Médiaesemény küldése' 'AMQP 0-9-1'

        // Háttérfolyamat az infrastruktúra felé
        mediaWorker.consumer -> messageBroker 'Feldolgozási feladat fogadása' 'AMQP 0-9-1'
        mediaWorker.storageUploader -> mediaStorage 'Tömörített fájl tárolása' 'S3 API'

        // Tároló a CDN felé
		mediaStorage -> cdn 'Tartalom replikálása' 'HTTPS'
	}

	allampol -> cc.webApp 'Böngész, ötletet javasol, szavaz, médiát tölt fel' '' 'HTTPS'
	admin -> cc.webApp 'Pályázatot hirdet, ötleteket moderál' '' 'HTTPS'
}

views {
	view context {
		title 'Community Choice - rendszerkörnyezeti diagram'
		include *
	}

	view containers of cc {
		title 'Community Choice - konténerdiagram'
		include *
	}

    view compVoting of cc.votingService {
        title 'Community Choice - szavazási szolgáltatás komponensdiagramja'
        include *
    }

    view compCampaignAdmin of cc.campaignAdminService {
        title 'Community Choice - pályázat- és adminisztrációkezelő szolgáltatás komponensdiagramja'
        include *
    }

    view compMediaWorker of cc.mediaWorker {
        title 'Community Choice - médiafeldolgozó háttérfolyamat komponensdiagramja'
        include *
    }
}
