specification {
	element actor {
		style {
			shape person
			color green
		}
	}

	element system {
		style {
			color primary
		}
	}

	element externalSystem {
		style {
			color amber
		}
	}

	element webapp {
		style {
			shape browser
			color sky
			icon tech:react
		}
	}

	element service {
		style {
			shape component
			color indigo
			icon tech:nodejs
		}
	}

	element worker {
		style {
			shape component
			color green
			icon tech:nodejs
		}
	}

	element queue {
		style {
			shape queue
			color red
			icon tech:rabbitmq
		}
	}

	element database {
		style {
			shape cylinder
			color blue
			icon tech:postgresql
		}
	}

	element cache {
		style {
			shape cylinder
			color red
			icon tech:redis
		}
	}

	element storage {
		style {
			color amber
		}
	}
}

model {
	allampol = actor 'Zamundai állampolgár' 'Ötleteket javasol és szavaz a helyi pályázatokon' 'Reszponzív böngésző'
	admin = actor 'Közigazgatási adminisztrátor' 'Pályázatokat hirdet és moderál' 'Hivatali böngésző'

	zamundaOne = externalSystem 'Zamunda One' 'Állami azonosítási és lakcímadat-szolgáltató API' 'OAuth2 / OpenID Connect + REST API' {
		style {
			color amber
		}
	}

	cdn = externalSystem 'Cloudflare CDN' 'Tömörített médiatartalmak gyors kiszolgálása' 'Cloudflare CDN' {
		style {
			color amber
		}
	}

	cc = system 'Community Choice Platform' 'Lehetővé teszi a polgárok számára helyi fejlesztési ötletek beküldését és szavazását' {
		webApp = webapp 'Web Alkalmazás' 'Felhasználói felület pályázatokhoz, ötletekhez és szavazáshoz' 'React + TypeScript' {
			style {
				color sky
				icon tech:react
				shape browser
			}
		}

		votingService = service 'Voting Service' 'Szavazatok felvétele és integritásának biztosítása' 'Node.js + NestJS REST API' {
			style {
				color green
				icon tech:nestjs
			}
		}

		campaignAdminService = service 'Campaign & Admin Service' 'Pályázatok, ötletek, médiatöltés és adminisztrációs műveletek kezelése' 'Node.js + NestJS REST API' {
			style {
				color indigo
				icon tech:nestjs
			}
		}

		messageBroker = queue 'Message Broker' 'Aszinkron eseménysor médiafeldolgozáshoz' 'RabbitMQ' {
			style {
				color red
				icon tech:rabbitmq
			}
		}

		mediaWorker = worker 'Media Worker' 'Képek és videók átméretezése és tömörítése' 'Node.js worker + Sharp + FFmpeg' {
			style {
				color amber
				icon tech:ffmpeg
			}
		}

		database = database 'Relációs adatbázis' 'Szavazatok, pályázatok, ötletek, felhasználók - közös adatbázis' 'PostgreSQL' {
			style {
				color blue
				icon tech:postgresql
			}
		}

		cache = cache 'Cache' 'Időzített session, rate limit és idempotency kulcsok gyors tárolása' 'Redis' {
			style {
				color red
				icon tech:redis
			}
		}

		mediaStorage = storage 'Médiafájl-tároló' 'Eredeti és tömörített képek, videók' 'MinIO object storage - S3-kompatibilis API' {
			style {
				color amber
			}
		}

		webApp -> votingService 'Szavaz' '' 'HTTPS + REST/JSON'
		webApp -> campaignAdminService 'Pályázatok, ötletek és admin műveletek' '' 'HTTPS + REST/JSON'
		webApp -> zamundaOne 'Hitelesítés és lakcímellenőrzés' '' 'OAuth2 / OpenID Connect'
		campaignAdminService -> messageBroker 'Médiaesemény küldése' '' 'RabbitMQ AMQP 0-9-1'
		messageBroker -> mediaWorker 'Feldolgozási feladat' '' 'RabbitMQ AMQP 0-9-1'
		mediaWorker -> mediaStorage 'Tömörített fájl tárolása' '' 'MinIO S3 API'
		mediaStorage -> cdn 'Tartalom replikálása' '' 'Cloudflare HTTPS'
		votingService -> database 'Szavazatokat ír/olvas' '' 'PostgreSQL wire protocol'
		campaignAdminService -> database 'Pályázatokat, ötleteket és admin adatokat ír/olvas' '' 'PostgreSQL wire protocol'
		votingService -> cache 'Idempotency és rate limit kulcsok' '' 'Redis protocol'
		campaignAdminService -> cache 'Session és rate limit kulcsok' '' 'Redis protocol'
	}

	allampol -> cc.webApp 'Böngész, ötletet javasol, szavaz, médiát tölt fel' '' 'HTTPS'
	admin -> cc.webApp 'Pályázatot hirdet, ötleteket moderál' '' 'HTTPS'
}

views {
	view context {
		title 'Community Choice - Context diagram'
		include *
	}

	view containers of cc {
		title 'Community Choice - Container diagram'
		include *
	}
}
