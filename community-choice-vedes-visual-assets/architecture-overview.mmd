flowchart LR
  Public["Publikus portál\nReact + TypeScript"] --> Edge["Ingress / API Gateway\nTLS · routing · rate limit · JWT elővalidálás"]
  Dashboard["Lakossági vezérlőpult\nReact + TypeScript"] --> Edge
  Admin["Közigazgatási panel\nReact + TypeScript"] --> Edge
  Edge --> BFF["Backend API / BFF\nNode.js + NestJS"]

  BFF --> VoteSvc["Szavazási szolgáltatás\nEligibility Snapshot · voter_key · append-only vote"]
  BFF --> CampaignSvc["Pályázat- és adminisztrációkezelő szolgáltatás\nötletek · kampányok · presigned URL"]
  VoteSvc --> Z1["Zamunda One\nOIDC + lakcímadat"]
  VoteSvc --> KMS["KMS / Vault Transit\nHMAC titkok"]

  VoteSvc --> Pooler["PgBouncer\nkapcsolatszám-kontroll"]
  CampaignSvc --> Pooler
  Audit --> Pooler
  Pooler --> DB[("PostgreSQL\ntruth source · partitions · outbox")]
  DB --> Relay["Outbox relay / CDC\nSKIP LOCKED vagy WAL"]
  Relay --> VoteStream[["vote-cast-events stream\nNATS JetStream / Kafka"]]

  CampaignSvc --> CampaignStream[["campaign-events stream"]]
  CampaignSvc --> MediaStream[["media-processing-requests stream"]]
  VoteStream --> Audit["Auditnaplózó szolgáltatás"]
  VoteStream --> Notify["Értesítési szolgáltatás"]
  CampaignStream --> Audit
  CampaignStream --> Notify
  MediaStream --> MediaWorker["Médiafeldolgozó háttérfolyamat"]

  Dashboard --> Raw[("Nyers média bucket\nMinIO / S3")]
  Admin --> Raw
  MediaWorker --> Raw
  MediaWorker --> Optimized[("Optimalizált média bucket\nMinIO")]
  Optimized --> CDN["CDN / edge cache"]
  BFF --> Redis[("Redis\ncache · session · idempotency")]

